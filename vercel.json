{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/browse", "destination": "/home.html" },
    { "source": "/home", "destination": "/home.html" },
    { "source": "/signup", "destination": "/signup.html" },
    { "source": "/signin", "destination": "/signup.html?mode=signin" }
  ]
}
